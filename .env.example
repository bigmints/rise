# Generate each value with: openssl rand -hex 32
RISE_HERMES_TOKEN=replace-with-a-long-random-token
RISE_CHECKIN_SECRET=replace-with-another-long-random-token
RISE_DASHBOARD_PASSWORD=replace-with-a-different-long-password

# Set to 1 when the dashboard is served only through HTTPS.
RISE_SECURE_COOKIE=0

# Keep localhost when a reverse proxy or Tailscale Serve exposes the dashboard.
RISE_BIND_ADDRESS=127.0.0.1
